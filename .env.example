# ==============================================
# AI-POWERED ATS RESUME BUILDER ENVIRONMENT CONFIG
# ==============================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ats_resume_builder
# For local dev without Postgres, fallback to SQLite:
# DATABASE_URL=sqlite:///./ats_resume_builder.db

# Redis & Background Workers
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration (OpenAI Compatible)
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL_NAME=gpt-4o-mini
AI_TEMPERATURE=0.7
AI_FALLBACK_TO_HEURISTICS=True

# File Storage & Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,docx,doc,txt

# OCR Configuration (Tesseract fallback)
ENABLE_OCR=True
TESSERACT_PATH=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME="ATS Resume AI"
